# ---------- Base de datos (PostgreSQL 16) ----------
# Rol de la app (sin privilegios, sujeto a RLS) y rol dueño (solo migraciones y alta de empresas)
DATABASE_URL=postgres://nuvamail:CLAVE@HOST:5432/nuvamail
DATABASE_ADMIN_URL=postgres://nuvamail_admin:CLAVE@HOST:5432/nuvamail

# ---------- Seguridad ----------
# Genere cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
UNSUB_SECRET=
NODE_ENV=production

# ---------- URLs ----------
PUBLIC_URL=https://mail.nuvaprod.com        # enlaces de baja y webhook
WEB_ORIGIN=https://mail.nuvaprod.com        # mismo dominio si la web la sirve la API

# ---------- Amazon SES / SNS ----------
AWS_REGION=us-east-1
SES_CONFIGURATION_SET=nuvamail
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:CUENTA:nuvamail-eventos
DRY_RUN=false                               # true = simulación, no envía

# ---------- Imágenes (S3 + CloudFront) ----------
S3_BUCKET=nuvamail-imagenes
S3_PUBLIC_URL=https://img.mail.nuvaprod.com

# ---------- Trabajador de envío ----------
WORKER=true                                 # se puede dejar en todas las réplicas: usa candado en PostgreSQL
